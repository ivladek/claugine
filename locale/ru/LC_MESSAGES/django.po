"%(igw_max)s configurations are stored: delete one of them to save another."
msgstr ""
"Сохранено %(igw_max)s конфигураций: удалите одну, чтобы сохранить другую."

msgid "Stored configurations (%(n)s of %(igw_max)s)"
msgstr "Сохранённые конфигурации (%(n)s из %(igw_max)s)"

