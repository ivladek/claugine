msgstr "Решение"

msgid "Resources to delete"
msgstr "Ресурсы к удалению"

msgid "Approve deletion"
msgstr "Одобрить удаление"

msgid "Reject"
msgstr "Отклонить"

msgid "Cancel request"
msgstr "Отменить заявку"

