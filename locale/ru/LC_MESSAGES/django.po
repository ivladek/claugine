msgstr "Каждая копия — папка claugine_<имя>_<дата>, создаётся здесь."

msgid ""
"Each backup is a folder platform_<name>_<address>_<date> created here, "
"beside the portal's."
msgstr ""
"Каждая копия — папка platform_<имя>_<адрес>_<дата>, создаётся здесь, рядом с"
" копиями портала."

msgid "Change backups"
msgstr "Изменить резервные копии"

msgid "For every resource pool of this site."
msgstr "Для всех пулов ресурсов этой площадки."

msgid "Backups are the site's, shown on its first resource pool"
msgstr ""
"Резервные копии принадлежат площадке и показаны на её первом пуле ресурсов"

msgid "Quota and what is in use, as read from the platform"
msgstr "Квота и использовано, по данным платформы"

msgid "The backups change is sent for approval."
msgstr "Изменение резервных копий отправлено на согласование."

msgid "The project has no resources on this site."
msgstr "У проекта нет ресурсов на этой площадке."

#: templates/staff/_portal_nodes.html
msgid "This needs the Enterprise edition: the Standard edition runs one node."
msgstr "Нужна редакция Enterprise: редакция Standard работает на одном узле."

