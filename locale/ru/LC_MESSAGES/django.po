#: templates/staff/settings.html:209
msgid "Local folder"
msgstr "Локальная папка"

#: accounts/appliance.py:1040
msgid "Each backup is a folder claugine_<name>_<date> created here."
msgstr "Каждая копия — папка claugine_<имя>_<дата>, создаётся здесь."

#: accounts/appliance.py:1043
msgid "Owner (user:group)"
msgstr "Владелец (user:group)"

#: accounts/appliance.py:1047
msgid ""
"The local backups (portal and platforms) are set to this owner, e.g. "
"portal:portal. Empty: the local folder's own owner."
msgstr ""
"Локальным копиям (портала и площадок) назначается этот владелец, например "
"portal:portal. Пусто: собственный владелец локальной папки."

#: accounts/appliance.py:1051 templates/staff/settings.html:200
msgid "Backup at"
msgstr "Копия в"

#: accounts/appliance.py:1052 templates/staff/settings.html:200
msgid "Once a day, e.g. 00:45."
msgstr "Раз в день, например 00:45."

#: accounts/appliance.py:1055 templates/staff/settings.html:201
msgid "Keep, days"
msgstr "Хранить, дней"

#: accounts/appliance.py:1057 templates/staff/settings.html:202
msgid "Archive password"
msgstr "Пароль архива"

#: accounts/appliance.py:1061
msgid "At least 12 characters. Keep it apart: it is needed to restore."
msgstr ""
"Не менее 12 символов. Храните его отдельно: он нужен для восстановления."

#: accounts/appliance.py:1104
msgid "Required for an external server."
msgstr "Обязательно для внешнего сервера."

#: accounts/appliance.py:1113
msgid "An email address, optionally with a name: Name <address>."
msgstr "Адрес электронной почты, можно с именем: Имя <адрес>."

#: accounts/appliance.py:1115
msgid "A PEM private key."
msgstr "Закрытый ключ PEM."

#: accounts/appliance.py:1120
msgid "An absolute path."
msgstr "Абсолютный путь."

#: accounts/appliance.py:1124
msgid "Required for a local copy."
msgstr "Требуется для локальной копии."

#: accounts/appliance.py:1128
msgid "Switch on a local folder and/or an S3 bucket."
msgstr "Включите локальную папку и/или бакет S3."

#: accounts/appliance.py:1130
msgid "Switch on the local folder."
msgstr "Включите локальную папку."

#: accounts/appliance.py:1134
msgid "At least 12 characters."
msgstr "Не менее 12 символов."

#: accounts/appliance.py:1138
msgid "Required: backups are encrypted."
msgstr "Обязательно: резервные копии шифруются."

