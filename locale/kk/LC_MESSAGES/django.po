#: accounts/appliance.py:1076
msgid "A PEM private key."
msgstr "PEM жабық кілті."

#: accounts/appliance.py:1081
msgid "An absolute path."
msgstr "Абсолюттік жол."

#: accounts/appliance.py:1085
msgid "Required for a local copy."
msgstr "Жергілікті көшірме үшін қажет."

#: accounts/appliance.py:1089
msgid "Switch on a local folder and/or an S3 bucket."
msgstr "Жергілікті қалтаны және/немесе S3 бакетін қосыңыз."

#: accounts/appliance.py:1091
msgid "Switch on the local folder."
msgstr "Жергілікті қалтаны қосыңыз."

#: accounts/appliance.py:1095
msgid "At least 12 characters."
msgstr "Кемінде 12 таңба."

#: accounts/appliance.py:1099
msgid "Required: backups are encrypted."
msgstr "Міндетті: сақтық көшірмелер шифрланады."

