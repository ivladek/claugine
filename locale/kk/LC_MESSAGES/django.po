msgstr ""
"Сертификаттардың тіркелгісі; оны тіркеу Let's Encrypt жазылушы келісімін "
"қабылдауды білдіреді."

msgid "Public ports of the OpenNebula front end"
msgstr "OpenNebula фронтендінің жария порттары"

msgid "Public port"
msgstr "Жария порт"

msgid "Front end port"
msgstr "Фронтенд порты"

msgid "Open to"
msgstr "Қолжетімді"

msgid "anywhere"
msgstr "барлық жерден"

msgid "the site's local networks"
msgstr "алаңның жергілікті желілеріне"

msgid "Front end names"
msgstr "Фронтенд атаулары"

