msgid "The host's storage is used by datastores of other platforms: %(d)s. Move them first."
msgstr "Хост қоймасын басқа платформалардың деректер қоймалары пайдаланады: %(d)s. Алдымен оларды көшіріңіз."

msgid "(what the steps do not show)"
msgstr "(қадамдарда жоғы)"

msgid "Confirmed to delete"
msgstr "Жоюға расталған"

msgid "not all subscriptions readable"
msgstr "барлық жазылымдар оқылмайды"

msgid "Services"
msgstr "Сервистер"

