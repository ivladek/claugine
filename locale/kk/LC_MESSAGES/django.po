msgstr "Әлі тексерілмеген: платформа әр жаңартылған сайын тексеріледі."

msgid "inconsistent"
msgstr "сәйкессіздік"

msgid "consistent"
msgstr "сәйкес"

msgid "checked"
msgstr "тексерілді"

msgid ""
"quotas the same as the portal's; nothing on the platform without a project"
msgstr "квоталар порталдағыдай; платформада жобасыз ештеңе жоқ"

msgid "Quota differs from the portal"
msgstr "Квота порталдан өзгеше"

