# ---- local only, never published ----
# leading "/" - only in the repository root

# git helper scripts
/git-*.sh

# old code
/_archive/

# hidden files and directories anywhere: editor, OS and FUSE leftovers
.*
# ... except this file
!.gitignore

# ---- sensitive data ----
# ignore everything under data/ ...
/data/**
# ... but keep walking into subdirectories ...
!/data/**/
# ... and publish only sample files
!/data/**/*SAMPLE*

# ---- tests ----
# real test data, sample is published: tests/claugine-cli_TEST_SAMPLE.sh
/tests/claugine-cli_TEST.sh
