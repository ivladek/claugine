# ---- local only, never published ----
# leading "/" - only in the repository root

# git helper scripts
/git-*.sh

# old code
/_archive/

# hidden files and directories anywhere: editor, OS and FUSE leftovers
.*
# ... except this file
!.gitignore

# ---- sensitive data ----
# data set: data/{inventory,secrets,runtime} - never published; data/SAMPLE - published sample
/data/**
!/data/**/
!/data/SAMPLE/**

# ---- tests ----
# real test data, sample is published: tests/claugine_TEST_SAMPLE.sh
/tests/claugine_TEST.sh
