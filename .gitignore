# ---- local only, never published ----
# leading "/" - only in the repository root

# git helper scripts
/git-*.sh

# old code
/_archive/

# prebuilt images: on Google Drive, see binaries/README.md
/binaries/*
!/binaries/README.md

# hidden files and directories anywhere: editor, OS and FUSE leftovers
.*
# ... except this file
!.gitignore

# ---- sensitive data ----
# data sets: data/<set>/{inventory,secrets,runtime,tests-data.sh,jobs-data.sh} - never published;
# data/SAMPLE - published sample; tests/ and jobs/ hold scripts only, their data is in the data set
/data/**
!/data/**/
!/data/SAMPLE/**
