#!/bin/bash
set -u

export SCRIPT_NAME="CLoud AUtomation enGINE"
export SCRIPT_AUTHOR="Vladislav Kirilin, [@]ivladek@me.com"
export SCRIPT_VER="02.10.00"
export SCRIPT_DATE="2026-10-15"
export SCRIPT_SOURCE="https://github.com/ivladek/claugine/tree/main"



# set the directory structure, load the modules and the internal data, check the tools
#   ssh_user=NAME (${USER})
#   ssh_port=N    (22)
#   ssh_keyf=FILE (${HOME}/.ssh/${USER}.key)
# return 0 - loaded
#        1 - already loaded, or error
function _script_INIT() {
  local arg; for arg in "$@"; do local "${arg}"; done
  local module var dir cmd

  if declare -F _log
  then
    _log "script: was loaded before"
    return 1
  fi

  declare -gr INV_VARS="CONFIG TEMPLATES INV SECRETS"
  declare -gA RUNTIME=()       # collected runtime data
  declare -g DIR_RUNTIME=""    # directory to export runtime data
  export ssh                   # ssh command including all required keys
  declare -gA help_data=()     # help: command name -> help text
  export DIR_SCRIPT=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
  DIR_SCRIPT="${DIR_SCRIPT%/bin}"

  export DIR_LIB="${DIR_SCRIPT}/lib"
  export DIR_CONFIG="${DIR_SCRIPT}/config/data"
  export DIR_TEMPLATES="${DIR_SCRIPT}/config/templates"
  export DIR_FILES="${DIR_SCRIPT}/config/files"

  echo "modules: load from ${DIR_LIB}"
  for module in "${DIR_LIB}"/claugine_*.sh
  do
    source "${module}"
  done  # module
  _log "script directory: ${DIR_SCRIPT}"

  export SSH_USER="${ssh_user:-${USER}}"
  export SSH_PORT="${ssh_port:-22}"
  export SSH_KEYF="${ssh_keyf:-${HOME}/.ssh/${USER}.key}"
  export SSH_PUB="$(ssh-keygen -y -f "${SSH_KEYF}" 2>/dev/null)"
  if [[ -z "${SSH_PUB}" ]]
  then
    _log_error "SSH key file ${SSH_KEYF} not accessible"
    return 1
  fi

  ssh="ssh -p ${SSH_PORT} -l ${SSH_USER} -i ${SSH_KEYF}"
  _log "to connect to all hosts: ${ssh}"
  export PLATFORMS=""

  for var in CONFIG TEMPLATES
  do
    dir="DIR_${var}"
    _log "internal data: load data from ${!dir} to ${var}"
    _data_load_var var=${var} dir="${!dir}" || return 1
  done  # var
  _log "internal data: files in directory ${DIR_FILES}"
  ls -l "${DIR_FILES}"

  _log -n "required tools: ["
  for cmd in $(inv_list var=CONFIG path=admin.tools)
  do
    if ! command -v "${cmd}" &>/dev/null
    then
      _log " - ]"
      _log_error "required tool \"${cmd}\" not found"
      return 1
    fi
    _log -n " ${cmd}"
  done  # cmd
  _log " ]"
}  # _script_INIT



# entry point
# direct run:
#   [--help]                 # commands list
#   [--help] command         # full help for command
# load by source             # load commands
# return 0 - loaded or help shown
#        1 - run directly or not loaded
function _script_MAIN() {
  local module cmd name
  local -a cmds

  # load script called using source
  if [[ "${BASH_SOURCE[0]}" != "$0" ]]
  then
    _script_INIT "$@" || return 1
  fi

  if [[ -n "${DIR_SCRIPT:-}" ]]
  then
    if [[ "${BASH_SOURCE[0]}" == "$0" ]]
    then
      declare -gA help_data=()
      for module in "${DIR_LIB}"/claugine_*.sh
      do
        source "${module}" >/dev/null
      done  # module
    fi

    mapfile -t cmds < <(printf '%s\n' "${!help_data[@]}" | sort)
    _log "commands: ${#cmds[@]}"

    if [[ -z "$*" || "$*" == "--help" ]]
    then
      for cmd in "${cmds[@]}"
      do
        _log "  ${cmd}"
      done  # cmd
    else
      for cmd in "${cmds[@]}"
      do
        for name in "$@"
        do
          [[ "${name}" == "--help" ]] && continue
          if [[ "${cmd}" == *"${name,,}"* ]]
          then
            _log "${help_data[${cmd}]}"
          fi
        done  # name
      done  # cmd
    fi

    _log "commands list: ${BASH_SOURCE[0]} [--help]"
    _log "command help: ${BASH_SOURCE[0]} [--help] command"

    if [[ -n "${PLATFORMS:-}" ]]
    then
      _log "data: loaded"
      _log "platforms: [${PLATFORMS}]"
    else
      _log "data: not loaded"
      _log "to load data use: data_load_provider inv=PATH secrets=PATH runtime=PATH"
    fi
  else
    echo "script: not loaded"
    echo "to load use: source ${BASH_SOURCE[0]}"
    return 1
  fi

  return 0
}  # _script_MAIN


echo "script: ${SCRIPT_NAME}"
echo "author: ${SCRIPT_AUTHOR}"
echo "version: ${SCRIPT_VER} #${SCRIPT_DATE}"
echo "source: ${SCRIPT_SOURCE}"

_script_MAIN "$@"
