#!/bin/bash
#
# /usr/lib/live/mount/medium/claugine/vyos-image-prepare - on customized VyOS ISO
# Creates initial config and writes vyos-postconfig-bootup.script
#
# Runs in VM console session booted from the customized VyOS ISO:
#   - login using vyos/vyos
#   - run "install image" - answer "yes" on all questions
#   - run "bash /usr/lib/live/mount/medium/claugine/vyos-image-prepare"
#
# When the VM is powered off: phase=finalize (vyos_image_to_platforms)
#
# Vladislav Kirilin, [@]ivladek@me.com, 2026-10-13

set -u

SCRIPT_NAME=$(readlink -f "$0")
SOURCE_DIR=$(dirname ${SCRIPT_NAME})
VYOS_DIR="/mnt/vyos"
CONTEXT_DIR="/mnt/context"

if ! part=$(sudo blkid -L persistence)
then
  echo "!!! ERROR !!! Run \"install image\" first"
  exit 1
fi
echo "installed VyOS: ${part}"

sudo mkdir -p "${VYOS_DIR}"
sudo mount "${part}" "${VYOS_DIR}"
CONFIG=$(sudo ls -d "${VYOS_DIR}"/boot/*/rw/opt/vyatta/etc/config)

sudo mkdir -p "${CONTEXT_DIR}"
sudo mount -o ro "$(sudo blkid -L CONTEXT)" "${CONTEXT_DIR}"
source <(sudo cat "${CONTEXT_DIR}/context.sh")
echo "context data: loaded"

pswd="$(base64 -d -w 0 <<< "${CRYPTED_PASSWORD_BASE64:-}" 2>/dev/null)"
footer="$(sudo grep '^//' "${CONFIG}/config.boot" 2>/dev/null)"

echo "setup config:"
sudo tee /tmp/config.boot <<EOF
interfaces {
    loopback lo {
    }
}
service {
    ssh {
        client-keepalive-interval 120
        disable-host-validation
        port 22
    }
}
system {
    config-management {
        commit-revisions 100
    }
    host-name vyos-router
    login {
        user vyos {
            authentication {
                encrypted-password "${pswd}"
            }
        }
    }
    option {
        ctrl-alt-delete ignore
        reboot-on-panic
        reboot-on-upgrade-failure 5
    }
    syslog {
        local {
            facility all {
                level info
            }
            facility local7 {
                level debug
            }
        }
    }
}

${footer}
EOF
sudo install -m 660 -g vyattacfg /tmp/config.boot "${CONFIG}/config.boot"

echo "setup scripts"
sudo install -d -m 775 -g vyattacfg "${CONFIG}/scripts"
for script in "${SOURCE_DIR}"/*
do
  [[ "${script}" == "${SCRIPT_NAME}" ]] && continue
  echo "  ${script}"
  sudo install -m 775 -g vyattacfg "${script}" "${CONFIG}/scripts/"
done  # script

sync
sudo umount "${VYOS_DIR}"
echo "done - power off in 10 seconds; then on the admin host: vyos_image_to_platforms"
sleep 10
poweroff
